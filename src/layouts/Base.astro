---
/** The HTML shell of every page. Clinic pages pass the clinic's theme; platform pages pass just a color. */
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
// The other fonts a clinic can choose. A browser only downloads the one in use.
import '@fontsource/cairo/400.css';
import '@fontsource/cairo/600.css';
import '@fontsource/cairo/700.css';
import '@fontsource/tajawal/400.css';
import '@fontsource/tajawal/700.css';
import '@fontsource/almarai/400.css';
import '@fontsource/almarai/700.css';
import '../styles/app.css';
import { bodyAttributes, type Theme } from '../lib/theme';
import { isHexColor } from '../lib/validate';

interface Props {
  title: string;
  /** A clinic's full look. Takes priority over `accent`. */
  theme?: Theme;
  accent?: string;
  /** Staff pages are private and must not appear in search results. */
  isPrivate?: boolean;
  /** Shows a line saying this is a demo with made-up data, so nobody mistakes it for a real business. */
  isDemo?: boolean;
}

const { title, theme, accent, isPrivate = false, isDemo = false } = Astro.props;
// Only a checked hex value or a cleaned theme may reach the page (see theme.ts).
const color = theme?.accent ?? (accent && isHexColor(accent) ? accent : undefined);
const body = theme ? bodyAttributes(theme) : color ? { style: `--accent: ${color}` } : {};
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {(isPrivate || isDemo) && <meta name="robots" content="noindex" />}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={color ?? '#0f766e'} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <slot name="head" />
  </head>
  <body {...body}>
    {isDemo && <p class="demo-bar">نسخة تجريبية من BuildTech · البيانات مش حقيقية</p>}
    <slot />
    <script>
      import '../scripts/feedback';
    </script>
  </body>
</html>
