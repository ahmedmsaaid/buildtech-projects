---
/** Staff dashboard shell: clinic name, navigation and sign-out. */
import Base from './Base.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const { clinic } = Astro.locals;

const links = [
  { href: '/admin', label: 'المواعيد' },
  { href: '/admin/patients', label: 'المرضى' },
  { href: '/admin/settings', label: 'الإعدادات' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/admin';
---

<Base title={`${title} · ${clinic.name}`} accent={clinic.accent} isPrivate>
  <header class="topbar">
    <div class="topbar__inner">
      <span class="topbar__name">{clinic.name}</span>
      <nav aria-label="أقسام اللوحة">
        {links.map((link) => <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>{link.label}</a>)}
      </nav>
      <a class="button button--small" href={`/${clinic.slug}`} target="_blank" rel="noopener">صفحة الحجز</a>
      <form method="post" action="/admin/logout">
        <button class="button button--small" type="submit">خروج</button>
      </form>
    </div>
  </header>

  <main class="page page--wide">
    <h1>{title}</h1>
    <slot />
  </main>
</Base>
