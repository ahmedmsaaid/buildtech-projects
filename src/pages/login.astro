---
/**
 * Sign-in for the staff of any customer. Where they land afterwards depends
 * on what their account bought: each product has its own dashboard.
 */
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { getAccountById } from '../lib/accounts';
import { currentUser, signIn } from '../lib/auth';
import { products } from '../lib/products';
import { signInLimiter } from '../lib/rate-limit';
import { text } from '../lib/validate';

async function dashboardOf(accountId: string): Promise<string> {
  const account = await getAccountById(accountId);
  return (account && products[account.product]?.dashboardPath) || '/';
}

// Someone already signed in goes straight to their dashboard.
const signedIn = await currentUser(Astro.cookies);
if (signedIn && Astro.request.method === 'GET') return Astro.redirect(await dashboardOf(signedIn.account_id));

let failed = false;
let limited = false;
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = text(form, 'email', 120);
  const password = typeof form.get('password') === 'string' ? String(form.get('password')) : '';

  limited = signInLimiter.isLimited(Astro.clientAddress);
  const accountId = limited ? null : await signIn(Astro.cookies, email, password);
  if (accountId) return Astro.redirect(await dashboardOf(accountId));
  failed = !limited;
}
---

<Base title="تسجيل الدخول" isPrivate>
  <main class="shell">
    <header class="hero">
      <div class="hero__id">
        <span class="avatar"><Icon name="key" /></span>
        <div>
          <h1>تسجيل الدخول</h1>
          <p>ادخل على لوحة نشاطك من أي جهاز.</p>
        </div>
      </div>
    </header>

    {failed && <p class="notice notice--error" role="alert"><Icon name="ban" />الإيميل أو كلمة السر غلط.</p>}
    {limited && <p class="notice notice--error" role="alert"><Icon name="ban" />محاولات كتير. جرّب تاني بعد عشر دقايق.</p>}

    <form class="card" method="post">
      <div class="field">
        <label for="email">الإيميل</label>
        <input id="email" class="ltr" name="email" type="email" value={email} autocomplete="username" required />
      </div>
      <div class="field">
        <label for="password">كلمة السر</label>
        <input id="password" class="ltr" name="password" type="password" autocomplete="current-password" required />
      </div>
      <button class="btn btn--primary btn--block" type="submit">دخول</button>
    </form>
  </main>
</Base>
