---
/**
 * Sign-in for the staff of any customer. Where they land afterwards depends
 * on what their account bought: each product has its own dashboard.
 * Visitors who are not customers yet can start a demo from here instead.
 *
 * This page wears the BuildTech brand, like the home page.
 */
import Base from '../layouts/Base.astro';
import { getAccountById } from '../lib/accounts';
import { currentUser, signIn } from '../lib/auth';
import { productList, products } from '../lib/products';
import { signInLimiter } from '../lib/rate-limit';
import { text } from '../lib/validate';

async function dashboardOf(accountId: string): Promise<string> {
  const account = await getAccountById(accountId);
  return (account && products[account.product]?.dashboardPath) || '/';
}

// Someone already signed in goes straight to their dashboard.
const signedIn = await currentUser(Astro.cookies);
if (signedIn && Astro.request.method === 'GET') return Astro.redirect(await dashboardOf(signedIn.account_id));

let failed = false;
let limited = false;
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = text(form, 'email', 120);
  const password = typeof form.get('password') === 'string' ? String(form.get('password')) : '';

  limited = signInLimiter.isLimited(Astro.clientAddress);
  const accountId = limited ? null : await signIn(Astro.cookies, email, password);
  if (accountId) return Astro.redirect(await dashboardOf(accountId));
  failed = !limited;
}

// On a customer's own address the page is theirs: their name, and no offer to try other products.
const { hostAccount } = Astro.locals;
// Set when someone asked for more demos than one person needs (see pages/try.ts).
const demoLater = Astro.url.searchParams.get('demo') === 'later';
---

<Base title="تسجيل الدخول · BuildTech" accent="#19c37d" isPrivate>
  <div class="auth">
    <aside class="auth__brand">
      <a class="auth__logo" href="/" aria-label="BuildTech">
        <svg viewBox="0 0 64 64" width="40" height="40" aria-hidden="true">
          <path d="M32 17v-6" stroke="#fff" stroke-width="4" fill="none" stroke-linecap="round"></path>
          <circle cx="32" cy="8.5" r="4" fill="#19c37d"></circle>
          <path fill-rule="evenodd" fill="#fff" d="M21 17h22a13 13 0 0 1 13 13v16a13 13 0 0 1-13 13H21a13 13 0 0 1-13-13V30a13 13 0 0 1 13-13zM21 24h22a7 7 0 0 1 7 7v13a7 7 0 0 1-7 7H21a7 7 0 0 1-7-7V31a7 7 0 0 1 7-7z"></path>
          <path d="M21 31l7 6.5-7 6.5" stroke="#19c37d" stroke-width="4.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M32 44h11" stroke="#19c37d" stroke-width="4.5" fill="none" stroke-linecap="round"></path>
        </svg>
        <span dir="ltr">Build<span>Tech</span></span>
      </a>

      <div class="auth__pitch">
        <p class="auth__eyebrow" dir="ltr">&gt; welcome_back</p>
        <h1>شغلك كله <span>في مكان واحد</span></h1>
        <ul>
          <li>ادخل من الموبايل أو الكمبيوتر</li>
          <li>بياناتك محفوظة ومتاحة في أي وقت</li>
          <li>نسخة احتياطية ودعم من BuildTech</li>
        </ul>
      </div>
    </aside>

    <main class="auth__panel">
      <section class="auth__card" aria-labelledby="signin-title">
        <h2 id="signin-title">تسجيل الدخول</h2>
        <p class="auth__dim">{hostAccount ? `لوحة ${hostAccount.name}` : 'ادخل على لوحة نشاطك.'}</p>

        {failed && <p class="auth__alert" role="alert">الإيميل أو كلمة السر غلط.</p>}
        {limited && <p class="auth__alert" role="alert">محاولات كتير. جرّب تاني بعد عشر دقايق.</p>}

        <form method="post">
          <div class="auth__field">
            <label for="email">الإيميل</label>
            <input id="email" name="email" type="email" value={email} autocomplete="username" dir="ltr" required />
          </div>
          <div class="auth__field">
            <label for="password">كلمة السر</label>
            <input id="password" name="password" type="password" autocomplete="current-password" dir="ltr" required />
          </div>
          <button class="auth__btn auth__btn--main" type="submit">دخول</button>
        </form>
        <p class="auth__dim auth__small">نسيت كلمة السر؟ كلّم BuildTech ونعملك واحدة جديدة.</p>
      </section>

      {!hostAccount && <section class="auth__card auth__card--try" aria-labelledby="try-title">
        <h2 id="try-title">لسه مش عميل؟</h2>
        <p class="auth__dim">جرّب أي نظام دلوقتي من غير تسجيل، بنسخة جاهزة فيها بيانات تجريبية.</p>
        {demoLater && <p class="auth__alert" role="alert">جرّبت كذا مرة قريب. استنى شوية وجرّب تاني.</p>}
        <div class="auth__tries">
          {
            productList.map((product) => (
              <form method="post" action="/try">
                <input type="hidden" name="product" value={product.key} />
                <button class="auth__btn" type="submit">جرّب {product.customers}</button>
              </form>
            ))
          }
        </div>
      </section>}
    </main>
  </div>
</Base>

<style is:global>
  /* Dark edge to edge, like the home page. */
  body:has(.auth) {
    background: #101314;
  }
</style>

<style>
  .auth {
    --ink: #101314;
    --panel: #181c1d;
    --edge: #2c3335;
    --paper: #f3f6f4;
    --dim: #a3aba6;
    --green: #19c37d;
    --red: #ff8a80;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 100vh;
    color: var(--paper);
  }

  .auth__brand {
    display: grid;
    align-content: space-between;
    gap: 2rem;
    padding: 1.5rem clamp(1rem, 0.5rem + 3vw, 3rem);
    /* The faint grid of the BuildTech brand. */
    background-image:
      linear-gradient(rgb(243 246 244 / 4%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(243 246 244 / 4%) 1px, transparent 1px);
    background-size: 56px 56px;
  }

  .auth__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    justify-self: start;
    color: #ffffff;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .auth__logo span span,
  .auth h1 span {
    color: var(--green);
  }

  /* On a phone the form comes first; the pitch is for screens with room to spare. */
  .auth__pitch {
    display: none;
  }

  .auth__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--green);
    font-family: Consolas, 'Courier New', monospace;
    font-size: 0.875rem;
    text-align: end;
  }

  .auth h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem);
    line-height: 1.25;
  }

  .auth__pitch ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    color: var(--dim);
    list-style: none;
  }

  .auth__pitch li {
    display: flex;
    gap: 0.625rem;
  }

  .auth__pitch li::before {
    content: '>';
    color: var(--green);
    font-family: Consolas, 'Courier New', monospace;
    font-weight: 700;
  }

  .auth__panel {
    display: grid;
    align-content: center;
    gap: 1rem;
    width: min(100% - 2rem, 26rem);
    margin-inline: auto;
    padding-block: 1rem 3rem;
  }

  .auth__card {
    display: grid;
    gap: 0.75rem;
    padding: 1.75rem;
    border: 1px solid var(--edge);
    border-radius: 0.875rem;
    background: var(--panel);
  }

  .auth__card--try {
    border-style: dashed;
  }

  .auth h2 {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.4;
  }

  .auth__dim {
    margin: 0;
    color: var(--dim);
  }

  .auth__small {
    font-size: 0.875rem;
  }

  .auth__alert {
    margin: 0;
    padding: 0.625rem 0.875rem;
    border: 1px solid rgb(255 138 128 / 40%);
    border-radius: 0.5rem;
    background: rgb(255 138 128 / 10%);
    color: var(--red);
    font-weight: 600;
  }

  .auth form {
    display: grid;
    gap: 1rem;
  }

  .auth__field {
    display: grid;
    gap: 0.375rem;
  }

  .auth__field label {
    font-weight: 600;
  }

  /* The shared form styles assume a light page; these inputs sit on the dark panel. */
  .auth__field input {
    height: 3rem;
    border-color: var(--edge);
    background-color: var(--ink);
    color: var(--paper);
    text-align: start;
  }

  .auth__field input:focus {
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgb(25 195 125 / 25%);
  }

  .auth__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--edge);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--paper);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition:
      background 150ms,
      border-color 150ms,
      color 150ms;
  }

  /* Dark text on green: white on this green is too faint to read. */
  .auth__btn--main {
    border-color: var(--green);
    background: var(--green);
    color: var(--ink);
  }

  .auth__btn:focus-visible {
    outline: 3px solid rgb(25 195 125 / 55%);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .auth__btn:hover {
      border-color: var(--green);
      color: var(--green);
    }

    .auth__btn--main:hover {
      border-color: var(--paper);
      background: var(--paper);
      color: var(--ink);
    }
  }

  .auth__tries {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.625rem;
  }

  @media (min-width: 56rem) {
    .auth {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }

    .auth__brand {
      padding-block: 2.5rem;
      border-inline-end: 1px solid var(--edge);
    }

    .auth__pitch {
      display: block;
      max-width: 30rem;
    }

    .auth__panel {
      padding-block: 3rem;
    }
  }
</style>
