---
/**
 * One clinic from the owner's side: its subscription and payments, turning
 * it off and on, its staff accounts, and opening its dashboard.
 */
import Icon from '../../../components/Icon.astro';
import Owner from '../../../layouts/Owner.astro';
import { startSession } from '../../../lib/auth';
import { getClinicById, type Clinic } from '../../../lib/clinics';
import {
  getClinicUsage,
  listPayments,
  listStaff,
  planLabels,
  planMonths,
  recordPayment,
  resetStaffPassword,
  setClinicStatus,
  stateLabels,
  subscriptionState,
  updateSubscription,
} from '../../../lib/platform';
import { addDays, formatDay, formatShortDay, isDay, nowIn } from '../../../lib/time';
import { text, wholeNumber } from '../../../lib/validate';

let clinic = await getClinicById(Astro.params.id ?? '');
if (!clinic) return Astro.redirect('/owner');

const today = nowIn('Africa/Cairo').day;
const here = `/owner/clinics/${clinic.id}`;
const plans = Object.keys(planLabels) as Clinic['plan'][];
const problems: string[] = [];
let newPassword: { email: string; password: string } | null = null;
let saved = Astro.url.searchParams.has('saved');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = text(form, '_action', 20);

  if (action === 'status') {
    await setClinicStatus(clinic.id, clinic.status === 'active' ? 'suspended' : 'active');
    return Astro.redirect(`${here}?saved`);
  }

  if (action === 'subscription') {
    const plan = text(form, 'plan', 10) as Clinic['plan'];
    const price = wholeNumber(form, 'price', 0, 1_000_000);
    const paidUntil = text(form, 'paid_until', 10);
    if (!plans.includes(plan)) problems.push('اختار خطة.');
    if (price === null) problems.push('سعر الاشتراك لازم يكون رقم.');
    if (paidUntil && !isDay(paidUntil)) problems.push('تاريخ نهاية الاشتراك مش صحيح.');

    if (problems.length === 0 && price !== null) {
      await updateSubscription(clinic.id, {
        plan,
        price,
        paid_until: paidUntil || null,
        contact_name: text(form, 'contact_name', 80),
        contact_phone: text(form, 'contact_phone', 20),
        owner_note: text(form, 'owner_note', 1000),
      });
      return Astro.redirect(`${here}?saved`);
    }
  }

  if (action === 'payment') {
    const amount = wholeNumber(form, 'amount', 0, 1_000_000);
    const months = wholeNumber(form, 'months', 1, 36);
    if (amount === null) problems.push('المبلغ لازم يكون رقم.');
    if (months === null) problems.push('عدد الشهور لازم يكون من 1 لـ 36.');

    if (problems.length === 0 && amount !== null && months !== null) {
      await recordPayment(clinic, amount, months, text(form, 'note', 120), today);
      return Astro.redirect(`${here}?saved`);
    }
  }

  if (action === 'reset-password') {
    const staff = (await listStaff(clinic.id)).find((account) => account.id === text(form, 'user_id', 40));
    const password = staff && (await resetStaffPassword(clinic.id, staff.id));
    if (staff && password) newPassword = { email: staff.email, password };
    else problems.push('الحساب ده مش موجود.');
  }

  // Signs this browser in as the clinic, so its dashboard opens exactly as its staff see it.
  if (action === 'open-dashboard') {
    const [staff] = await listStaff(clinic.id);
    if (clinic.status === 'suspended') problems.push('العيادة موقوفة. فعّلها الأول عشان تفتح لوحتها.');
    else if (!staff) problems.push('العيادة ملهاش حساب دخول.');
    else {
      await startSession(Astro.cookies, staff.id);
      return Astro.redirect('/admin');
    }
  }

  saved = false;
  clinic = (await getClinicById(clinic.id)) ?? clinic;
}

const [usage, payments, staff] = await Promise.all([getClinicUsage(clinic.id, addDays(today, -29)), listPayments(clinic.id), listStaff(clinic.id)]);
const state = subscriptionState(clinic, today);
const tone = { active: 'done', expiring: 'arrived', expired: 'no_show', suspended: 'cancelled' }[state];
const totalPaid = payments.reduce((sum, payment) => sum + payment.amount, 0);
const defaultMonths = planMonths[clinic.plan] || 1;
---

<Owner title={clinic.name} subtitle={[clinic.doctor_name, clinic.specialty].filter(Boolean).join(' · ') || `/${clinic.slug}`}>
  <Fragment slot="actions">
    <span class="badge" data-status={tone}>{stateLabels[state]}</span>
    <a class="btn btn--sm" href={`/${clinic.slug}`} target="_blank" rel="noopener"><Icon name="external" />صفحة الحجز</a>
    <form method="post" target="_blank">
      <input type="hidden" name="_action" value="open-dashboard" />
      <button class="btn btn--sm btn--primary" type="submit"><Icon name="key" />ادخل لوحة العيادة</button>
    </form>
  </Fragment>

  {saved && <p class="notice" role="status"><Icon name="check" />اتحفظ.</p>}
  {
    problems.length > 0 && (
      <div class="notice notice--error" role="alert">
        <Icon name="ban" />
        <ul>{problems.map((problem) => <li>{problem}</li>)}</ul>
      </div>
    )
  }
  {
    newPassword && (
      <section class="card" role="status">
        <h2 class="card__title"><Icon name="key" />كلمة سر جديدة</h2>
        <p>ابعتها للعيادة. <strong>مش هتظهر تاني</strong>، والحساب اتسجّل خروجه من كل الأجهزة.</p>
        <dl class="facts">
          <dt>الإيميل</dt>
          <dd class="ltr">{newPassword.email}</dd>
          <dt>كلمة السر</dt>
          <dd class="ltr">{newPassword.password}</dd>
        </dl>
      </section>
    )
  }

  <div class="stats">
    <p class="stat"><span class="stat__icon"><Icon name="calendar" /></span><span><strong>{usage.bookings_30d}</strong><span>حجز في 30 يوم</span></span></p>
    <p class="stat"><span class="stat__icon"><Icon name="users" /></span><span><strong>{usage.patients}</strong><span>مريض</span></span></p>
    <p class="stat"><span class="stat__icon"><Icon name="external" /></span><span><strong>{usage.online_share}%</strong><span>حجز أونلاين</span></span></p>
    <p class="stat"><span class="stat__icon"><Icon name="wallet" /></span><span><strong>{totalPaid}</strong><span>إجمالي المدفوع (ج)</span></span></p>
  </div>

  <div class="board">
    <div class="stack">
      <form class="card" method="post">
        <input type="hidden" name="_action" value="subscription" />
        <div class="card__head">
          <h2 class="card__title"><Icon name="wallet" />الاشتراك</h2>
          <span class="muted small">
            {clinic.paid_until ? `ساري لحد ${formatDay(clinic.paid_until)}` : 'ما اتدفعش قبل كده'}
          </span>
        </div>
        <div class="grid-2">
          <div class="field">
            <label for="plan">الخطة</label>
            <select id="plan" name="plan">
              {plans.map((plan) => <option value={plan} selected={plan === clinic.plan}>{planLabels[plan]}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="price">سعر الاشتراك (ج)</label>
            <input id="price" name="price" type="number" value={clinic.price} min="0" required />
          </div>
          <div class="field">
            <label for="paid_until">الاشتراك ساري لحد</label>
            <input id="paid_until" name="paid_until" type="date" value={clinic.paid_until ?? ''} />
            <p class="hint">بيتحدّث لوحده لما تسجّل دفعة. عدّله بإيدك بس لو فيه تصحيح.</p>
          </div>
          <div class="field">
            <label for="contact_name">اسم المسؤول</label>
            <input id="contact_name" name="contact_name" type="text" value={clinic.contact_name} maxlength="80" />
          </div>
          <div class="field">
            <label for="contact_phone">موبايل المسؤول</label>
            <input id="contact_phone" class="ltr" name="contact_phone" type="tel" value={clinic.contact_phone} maxlength="20" />
          </div>
        </div>
        <div class="field">
          <label for="owner_note">ملاحظاتك عن العيادة</label>
          <textarea id="owner_note" name="owner_note" rows="3" maxlength="1000">{clinic.owner_note}</textarea>
          <p class="hint">ليك إنت بس. العيادة مش بتشوفها.</p>
        </div>
        <div><button class="btn btn--primary" type="submit">حفظ الاشتراك</button></div>
      </form>

      <section class="card" aria-labelledby="payments-title">
        <h2 id="payments-title" class="card__title"><Icon name="chart" />الدفعات</h2>
        {
          payments.length === 0 ? (
            <p class="muted">لسه مفيش دفعات مسجّلة.</p>
          ) : (
            <div class="table-wrap">
              <table class="cards-on-phone">
                <thead>
                  <tr>
                    <th>التاريخ</th>
                    <th>المبلغ</th>
                    <th>غطّت لحد</th>
                    <th>ملاحظة</th>
                  </tr>
                </thead>
                <tbody>
                  {payments.map((payment) => (
                    <tr>
                      <td data-label="التاريخ">{formatShortDay(payment.paid_on)}</td>
                      <td data-label="المبلغ">{payment.amount} ج</td>
                      <td data-label="غطّت لحد">{formatShortDay(payment.covers_until)}</td>
                      <td data-label="ملاحظة">{payment.note || '·'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </section>
    </div>

    <div class="board__side stack">
      <form class="card" method="post">
        <input type="hidden" name="_action" value="payment" />
        <h2 class="card__title"><Icon name="plus" />تسجيل دفعة</h2>
        <div class="grid-2">
          <div class="field">
            <label for="amount">المبلغ (ج)</label>
            <input id="amount" name="amount" type="number" value={clinic.price} min="0" required />
          </div>
          <div class="field">
            <label for="months">عدد الشهور</label>
            <input id="months" name="months" type="number" value={defaultMonths} min="1" max="36" required />
          </div>
        </div>
        <div class="field">
          <label for="note">ملاحظة (اختياري)</label>
          <input id="note" name="note" type="text" maxlength="120" placeholder="إنستاباي، كاش..." />
        </div>
        <button class="btn btn--primary btn--block" type="submit">سجّل الدفعة ومدّ الاشتراك</button>
        <p class="hint">المدة بتتحسب من نهاية الاشتراك الحالي، أو من النهارده لو منتهي.</p>
      </form>

      <section class="card" aria-labelledby="staff-title">
        <h2 id="staff-title" class="card__title"><Icon name="users" />حسابات الدخول</h2>
        <ul class="queue">
          {
            staff.map((account) => (
              <li>
                <span class="grow">
                  <strong class="ltr">{account.email}</strong>
                  {account.name && <span class="block muted small">{account.name}</span>}
                </span>
                <form method="post">
                  <input type="hidden" name="_action" value="reset-password" />
                  <input type="hidden" name="user_id" value={account.id} />
                  <button class="btn btn--sm" type="submit">كلمة سر جديدة</button>
                </form>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="card" aria-labelledby="status-title">
        <h2 id="status-title" class="card__title"><Icon name="ban" />{clinic.status === 'active' ? 'إيقاف العيادة' : 'العيادة موقوفة'}</h2>
        <p class="hint">
          {
            clinic.status === 'active'
              ? 'الإيقاف بيقفل الحجز الأونلاين ولوحة العيادة فوراً. البيانات بتفضل محفوظة وترجع لما تفعّلها.'
              : 'الحجز الأونلاين ولوحة العيادة مقفولين. التفعيل بيرجّع كل حاجة زي ما كانت.'
          }
        </p>
        <form method="post">
          <input type="hidden" name="_action" value="status" />
          <button class:list={['btn', 'btn--block', clinic.status === 'active' ? 'btn--danger' : 'btn--primary']} type="submit">
            {clinic.status === 'active' ? 'أوقف العيادة' : 'فعّل العيادة'}
          </button>
        </form>
      </section>
    </div>
  </div>
</Owner>
