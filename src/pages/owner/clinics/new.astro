---
/**
 * Adds a clinic and its first staff account. The account's password is
 * generated here and shown once on the result screen: it is not stored in
 * readable form and is never put in a link.
 */
import Icon from '../../../components/Icon.astro';
import Owner from '../../../layouts/Owner.astro';
import type { Clinic } from '../../../lib/clinics';
import { createClinic, planLabels } from '../../../lib/platform';
import { nowIn } from '../../../lib/time';
import { egyptianMobile, text, wholeNumber } from '../../../lib/validate';

/** Addresses that already mean something on the site. */
const RESERVED_SLUGS = ['admin', 'owner', 'api', 'demo'];
const plans = Object.keys(planLabels) as Clinic['plan'][];

const problems: string[] = [];
let typed = { name: '', slug: '', specialty: '', doctorName: '', contactName: '', contactPhone: '', staffEmail: '', plan: 'trial' as Clinic['plan'], price: '' };
let created: { clinicId: string; password: string } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const plan = text(form, 'plan', 10) as Clinic['plan'];
  typed = {
    name: text(form, 'name', 80),
    slug: text(form, 'slug', 40).toLowerCase(),
    specialty: text(form, 'specialty', 80),
    doctorName: text(form, 'doctor_name', 80),
    contactName: text(form, 'contact_name', 80),
    contactPhone: text(form, 'contact_phone', 20),
    staffEmail: text(form, 'staff_email', 120).toLowerCase(),
    plan: plans.includes(plan) ? plan : 'trial',
    price: text(form, 'price', 8),
  };
  const price = wholeNumber(form, 'price', 0, 1_000_000);
  const mobile = typed.contactPhone ? egyptianMobile(typed.contactPhone) : '';

  if (!typed.name) problems.push('اسم العيادة مطلوب.');
  if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(typed.slug)) problems.push('اللينك لازم يكون حروف إنجليزية صغيرة وأرقام وشرطات بس.');
  else if (RESERVED_SLUGS.includes(typed.slug)) problems.push('اللينك ده محجوز للنظام. اختار غيره.');
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(typed.staffEmail)) problems.push('اكتب إيميل صحيح لحساب العيادة.');
  if (mobile === null) problems.push('رقم موبايل المسؤول لازم يكون 11 رقم ويبدأ بـ 01.');
  if (price === null) problems.push('سعر الاشتراك لازم يكون رقم. اكتب 0 للتجربة المجانية.');

  if (problems.length === 0 && price !== null && mobile !== null) {
    const result = await createClinic({ ...typed, contactPhone: mobile, price }, nowIn('Africa/Cairo').day);
    if (result.ok) created = result;
    else problems.push(result.reason === 'slug_taken' ? 'اللينك ده مستخدم لعيادة تانية.' : 'الإيميل ده مستخدم لحساب تاني.');
  }
}
---

<Owner title="عيادة جديدة" subtitle="العيادة بتتعمل جاهزة للشغل، وبتبدأ بـ 14 يوم تجربة">
  <a slot="actions" class="btn btn--sm btn--ghost" href="/owner">كل العيادات</a>

  {
    created ? (
      <section class="card" aria-labelledby="done-title">
        <h2 id="done-title" class="card__title"><Icon name="check" />العيادة اتعملت</h2>
        <p>ابعت البيانات دي للعيادة. <strong>كلمة السر مش هتظهر تاني</strong>، ولو ضاعت تقدر تعمل واحدة جديدة من صفحة العيادة.</p>
        <dl class="facts">
          <dt>لينك الحجز</dt>
          <dd class="ltr">{new URL(`/${typed.slug}`, Astro.url).href}</dd>
          <dt>لوحة العيادة</dt>
          <dd class="ltr">{new URL('/admin', Astro.url).href}</dd>
          <dt>الإيميل</dt>
          <dd class="ltr">{typed.staffEmail}</dd>
          <dt>كلمة السر</dt>
          <dd class="ltr">{created.password}</dd>
        </dl>
        <div class="row">
          <a class="btn btn--primary" href={`/owner/clinics/${created.clinicId}`}>افتح صفحة العيادة</a>
          <a class="btn" href="/owner/clinics/new">ضيف عيادة تانية</a>
        </div>
      </section>
    ) : (
      <>
        {problems.length > 0 && (
          <div class="notice notice--error" role="alert">
            <Icon name="ban" />
            <ul>{problems.map((problem) => <li>{problem}</li>)}</ul>
          </div>
        )}

        <form class="stack" method="post">
          <section class="card">
            <h2 class="card__title"><Icon name="building" />العيادة</h2>
            <div class="grid-2">
              <div class="field">
                <label for="name">اسم العيادة</label>
                <input id="name" name="name" type="text" value={typed.name} required maxlength="80" />
              </div>
              <div class="field">
                <label for="slug">لينك العيادة</label>
                <input id="slug" class="ltr" name="slug" type="text" value={typed.slug} required maxlength="40" placeholder="dr-ahmed" pattern="[a-z0-9]+(-[a-z0-9]+)*" />
                <p class="hint">بيبقى عنوان صفحة الحجز. حروف إنجليزية صغيرة وشرطات.</p>
              </div>
              <div class="field">
                <label for="doctor_name">اسم الدكتور</label>
                <input id="doctor_name" name="doctor_name" type="text" value={typed.doctorName} maxlength="80" />
              </div>
              <div class="field">
                <label for="specialty">التخصص</label>
                <input id="specialty" name="specialty" type="text" value={typed.specialty} maxlength="80" />
              </div>
            </div>
          </section>

          <section class="card">
            <h2 class="card__title"><Icon name="users" />المسؤول وحساب الدخول</h2>
            <div class="grid-2">
              <div class="field">
                <label for="contact_name">اسم المسؤول</label>
                <input id="contact_name" name="contact_name" type="text" value={typed.contactName} maxlength="80" />
              </div>
              <div class="field">
                <label for="contact_phone">موبايل المسؤول</label>
                <input id="contact_phone" class="ltr" name="contact_phone" type="tel" value={typed.contactPhone} inputmode="tel" placeholder="01xxxxxxxxx" />
              </div>
              <div class="field">
                <label for="staff_email">إيميل حساب العيادة</label>
                <input id="staff_email" class="ltr" name="staff_email" type="email" value={typed.staffEmail} required maxlength="120" />
                <p class="hint">العيادة هتدخل بيه على لوحتها. كلمة السر بتتعمل تلقائي.</p>
              </div>
            </div>
          </section>

          <section class="card">
            <h2 class="card__title"><Icon name="wallet" />الاشتراك</h2>
            <div class="grid-2">
              <div class="field">
                <label for="plan">الخطة</label>
                <select id="plan" name="plan">
                  {plans.map((plan) => <option value={plan} selected={plan === typed.plan}>{planLabels[plan]}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="price">سعر الاشتراك (ج)</label>
                <input id="price" name="price" type="number" value={typed.price || '0'} min="0" required />
                <p class="hint">المبلغ عن كل فترة من الخطة: شهر أو سنة.</p>
              </div>
            </div>
          </section>

          <div><button class="btn btn--primary" type="submit"><Icon name="plus" />اعمل العيادة</button></div>
        </form>
      </>
    )
  }
</Owner>
