---
/** The product's front door. Each clinic lives at its own address: /<clinic>. */
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { usesLocalDatabase } from '../lib/db';

const features = [
  { icon: 'calendar', title: 'حجز أونلاين', body: 'المريض يحجز من لينك باسم العيادة في أقل من دقيقة، من غير مكالمات.' },
  { icon: 'hourglass', title: 'طابور انتظار حي', body: 'المريض يشوف قدامه كام واحد من موبايله، والاستقبال يرتّب الدخول.' },
  { icon: 'chat', title: 'تذكير واتساب', body: 'رسالة تذكير جاهزة لكل مريض بضغطة، فالغياب يقل.' },
  { icon: 'chart', title: 'تقارير وإيراد', body: 'عدد الحجوزات ونسبة الحضور وإيراد كل يوم قدامك.' },
] as const;
---

<Base title="حجز العيادات · BuildTech">
  <main class="shell">
    <header class="hero">
      <div class="hero__id">
        <span class="avatar"><Icon name="pulse" /></span>
        <div>
          <h1>حجز العيادات</h1>
          <p>نظام مواعيد كامل لعيادتك، من الحجز لحد الكشف.</p>
        </div>
      </div>
      <div class="row">
        {usesLocalDatabase && <a class="btn" href="/demo">جرّب صفحة الحجز</a>}
        <a class="btn btn--ghost chip" href="/login">دخول العملاء</a>
        <a class="btn btn--ghost chip" href="/owner">لوحة المنصة</a>
      </div>
    </header>

    <div class="grid-2">
      {
        features.map((feature) => (
          <section class="card">
            <h2 class="card__title"><Icon name={feature.icon} />{feature.title}</h2>
            <p class="muted">{feature.body}</p>
          </section>
        ))
      }
    </div>
    <p class="foot">من BuildTech</p>
  </main>
</Base>
