---
/**
 * The platform's front door. Customers each have their own address
 * (/<slug>) and sign in at /login; this page is for someone who arrives
 * at the bare address.
 */
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { usesLocalDatabase } from '../lib/db';

const offers = [
  { icon: 'pulse', title: 'حجز العيادات', body: 'المريض يحجز من لينك باسم العيادة، ويتابع دوره من موبايله. الاستقبال يدير اليوم كله من لوحة واحدة.', demo: '/demo' },
  { icon: 'building', title: 'منيو وطلبات المطاعم', body: 'الزبون يمسح كود الترابيزة ويطلب من موبايله، والطلب يوصل المطبخ على طول.', demo: '/resto' },
] as const;
---

<Base title="منتجات BuildTech">
  <main class="shell">
    <header class="hero">
      <div class="hero__id">
        <span class="avatar"><Icon name="building" /></span>
        <div>
          <h1>منتجات BuildTech</h1>
          <p>أنظمة جاهزة لشغلك، بتشتغل من المتصفح زي التطبيق.</p>
        </div>
      </div>
      <div class="row">
        <a class="btn" href="/login"><Icon name="key" />دخول العملاء</a>
      </div>
    </header>

    <div class="grid-2">
      {
        offers.map((offer) => (
          <section class="card">
            <h2 class="card__title"><Icon name={offer.icon} />{offer.title}</h2>
            <p class="muted">{offer.body}</p>
            {/* The demo customers exist only in the local development database. */}
            {usesLocalDatabase && <div><a class="btn btn--sm btn--soft" href={offer.demo}>شوف التجربة</a></div>}
          </section>
        ))
      }
    </div>

    <p class="foot">عايز نظام لنشاطك؟ كلّم BuildTech.</p>
  </main>
</Base>
