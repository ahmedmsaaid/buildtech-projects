---
/** How the clinic is doing over a period: bookings, attendance, income, and where bookings come from. */
import Icon from '../../components/Icon.astro';
import Admin from '../../layouts/Admin.astro';
import { getReport } from '../../lib/appointments';
import { wordsForBooking } from '../../lib/words';
import { addDays, formatDay, formatShortDay, nowIn } from '../../lib/time';

const { clinic } = Astro.locals;
const w = wordsForBooking(clinic.product);
const today = nowIn(clinic.timezone).day;

const ranges = [7, 30, 90];
const requested = Number(Astro.url.searchParams.get('days'));
const span = ranges.includes(requested) ? requested : 30;
const fromDay = addDays(today, -(span - 1));

const report = await getReport(clinic.id, fromDay, today);
const { totals } = report;

const share = (part: number, whole: number) => (whole === 0 ? 0 : Math.round((part / whole) * 100));
// Attendance is judged on visits that already have an outcome.
const settled = totals.done + totals.no_shows;

// The chart always shows the last 14 days, including days with no bookings.
const chartDays = Array.from({ length: 14 }, (_, offset) => addDays(today, offset - 13)).map((day) => ({
  day,
  bookings: report.perDay.find((entry) => entry.day === day)?.bookings ?? 0,
}));
const tallest = Math.max(1, ...chartDays.map((entry) => entry.bookings));
const topService = Math.max(1, ...report.services.map((service) => service.visits));
---

<Admin title="التقارير" subtitle={`من ${formatDay(fromDay)} لحد النهارده`}>
  <Fragment slot="actions">
    {
      ranges.map((days) => (
        <a class:list={['btn', 'btn--sm', { 'btn--primary': days === span }]} href={`/admin/reports?days=${days}`}>
          آخر {days} يوم
        </a>
      ))
    }
  </Fragment>

  <div class="stats">
    <p class="stat"><span class="stat__icon"><Icon name="calendar" /></span><span><strong>{totals.bookings}</strong><span>حجز</span></span></p>
    <p class="stat"><span class="stat__icon"><Icon name="users" /></span><span><strong>{totals.patients}</strong><span>{w.client1}</span></span></p>
    <p class="stat"><span class="stat__icon"><Icon name="wallet" /></span><span><strong>{totals.revenue}</strong><span>الإيراد (ج)</span></span></p>
    <p class="stat"><span class="stat__icon" data-tone="ok"><Icon name="check" /></span><span><strong>{share(totals.done, settled)}%</strong><span>نسبة الحضور</span></span></p>
    <p class="stat"><span class="stat__icon" data-tone="bad"><Icon name="ban" /></span><span><strong>{totals.no_shows}</strong><span>ما جاش</span></span></p>
  </div>

  <section class="card" aria-labelledby="chart-title">
    <h2 id="chart-title" class="card__title"><Icon name="chart" />الحجوزات في آخر 14 يوم</h2>
    <div class="bars" role="img" aria-label={`الحجوزات اليومية في آخر 14 يوم، أعلى يوم فيه ${tallest} حجز`}>
      {
        chartDays.map((entry) => (
          <div class="bars__col">
            <span class="bars__value">{entry.bookings || ''}</span>
            <span class="bars__bar" data-empty={entry.bookings === 0 ? '' : undefined} style={`height: ${(entry.bookings / tallest) * 100}%`} />
            <span class="bars__label">{formatShortDay(entry.day).split(' ')[0]}</span>
          </div>
        ))
      }
    </div>
  </section>

  <div class="grid-2">
    <section class="card" aria-labelledby="services-title">
      <h2 id="services-title" class="card__title"><Icon name="pulse" />أنواع الزيارة</h2>
      {
        report.services.length === 0 ? (
          <p class="muted">مفيش حجوزات في الفترة دي.</p>
        ) : (
          <ul class="split">
            {report.services.map((service) => (
              <li class="stack stack--tight">
                <div class="row row--spread">
                  <strong>{service.service_name}</strong>
                  <span class="muted small">{service.visits} حجز · {service.revenue} ج</span>
                </div>
                <div class="meter"><span style={`width: ${(service.visits / topService) * 100}%`} /></div>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="card" aria-labelledby="source-title">
      <h2 id="source-title" class="card__title"><Icon name="external" />الحجوزات جاية منين</h2>
      <ul class="split">
        <li class="stack stack--tight">
          <div class="row row--spread">
            <strong>أونلاين من صفحة الحجز</strong>
            <span class="muted small">{totals.online} · {share(totals.online, totals.bookings)}%</span>
          </div>
          <div class="meter"><span style={`width: ${share(totals.online, totals.bookings)}%`} /></div>
        </li>
        <li class="stack stack--tight">
          <div class="row row--spread">
            <strong>من الاستقبال</strong>
            <span class="muted small">{totals.bookings - totals.online} · {share(totals.bookings - totals.online, totals.bookings)}%</span>
          </div>
          <div class="meter"><span style={`width: ${share(totals.bookings - totals.online, totals.bookings)}%`} /></div>
        </li>
      </ul>
      <p class="hint">الحجوزات الملغية ({totals.cancelled}) مش محسوبة في الأرقام.</p>
    </section>
  </div>
</Admin>
