---
/** Everyone who has booked at the clinic, with how often they came and how often they did not. */
import Admin from '../../layouts/Admin.astro';
import { getPatients } from '../../lib/appointments';
import { formatDay } from '../../lib/time';

const { clinic } = Astro.locals;
const search = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 60);
const patients = await getPatients(clinic.id, search);
---

<Admin title="المرضى">
  <form class="row" method="get" role="search">
    <input name="q" type="search" value={search} placeholder="ابحث بالاسم أو رقم الموبايل" aria-label="بحث في المرضى" class="grow" />
    <button class="button" type="submit">بحث</button>
  </form>

  {
    patients.length === 0 ? (
      <p class="card muted">{search ? 'مفيش مريض بالاسم أو الرقم ده.' : 'لسه مفيش مرضى. أول حجز هيظهر هنا.'}</p>
    ) : (
      <div class="card table-wrap">
        <table>
          <thead>
            <tr>
              <th>الاسم</th>
              <th>الموبايل</th>
              <th>الحجوزات</th>
              <th>ما جاش</th>
              <th>آخر ميعاد</th>
            </tr>
          </thead>
          <tbody>
            {patients.map((patient) => (
              <tr>
                <td>{patient.patient_name}</td>
                <td><a class="ltr" href={`tel:${patient.patient_phone}`}>{patient.patient_phone}</a></td>
                <td>{patient.visits}</td>
                <td>{patient.no_shows}</td>
                <td><a href={`/admin?date=${patient.last_day}`}>{formatDay(patient.last_day)}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</Admin>
