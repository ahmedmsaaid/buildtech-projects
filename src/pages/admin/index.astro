---
/**
 * The front desk's view of one day: a timeline of every slot, the waiting
 * queue, payments, WhatsApp reminders, and adding a booking by hand.
 */
import Icon from '../../components/Icon.astro';
import Admin from '../../layouts/Admin.astro';
import {
  appointmentStatuses,
  bookAppointment,
  getAppointmentsOn,
  getDayCounts,
  getSlots,
  setAppointmentStatus,
  setPaidAmount,
  statusLabels,
  type Appointment,
  type AppointmentStatus,
} from '../../lib/appointments';
import { getServices } from '../../lib/clinics';
import { addDays, formatDay, formatMinute, isDay, nowIn, weekdayNames, weekdayOf } from '../../lib/time';
import { egyptianMobile, text, whatsappNumber, wholeNumber } from '../../lib/validate';

const { clinic } = Astro.locals;
const now = nowIn(clinic.timezone);
const today = now.day;
const requested = Astro.url.searchParams.get('date');
const day = isDay(requested) ? requested : today;
const dayPath = `/admin?date=${day}`;

const problems: string[] = [];
let typed = { name: '', phone: '' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = text(form, '_action', 20);
  const id = text(form, 'id', 40);

  if (action === 'status') {
    const status = text(form, 'status', 20) as AppointmentStatus;
    if (appointmentStatuses.includes(status)) {
      const change = await setAppointmentStatus(clinic.id, id, status);
      if (change === 'slot_taken') problems.push('الميعاد ده اتحجز لحد تاني، فمش هينفع يرجع.');
      else return Astro.redirect(dayPath);
    }
  }

  if (action === 'paid') {
    const amount = wholeNumber(form, 'paid', 0, 1_000_000);
    if (amount === null) problems.push('المبلغ المدفوع لازم يكون رقم.');
    else {
      await setPaidAmount(clinic.id, id, amount);
      return Astro.redirect(dayPath);
    }
  }

  if (action === 'add') {
    typed = { name: text(form, 'name', 80), phone: text(form, 'phone', 20) };
    const mobile = egyptianMobile(typed.phone);
    if (typed.name.length < 3) problems.push('اكتب اسم المريض.');
    if (!mobile) problems.push('رقم الموبايل لازم يكون 11 رقم ويبدأ بـ 01.');

    if (problems.length === 0 && mobile) {
      const result = await bookAppointment(clinic, {
        day,
        minute: Number(text(form, 'minute', 5) || -1),
        serviceId: text(form, 'service', 40),
        patientName: typed.name,
        patientPhone: mobile,
        source: 'staff',
      });
      if (result.ok) return Astro.redirect(dayPath);
      problems.push(result.reason === 'slot_taken' ? 'الساعة دي اتحجزت. اختار ساعة تانية.' : 'اختار ساعة ونوع زيارة من المعروض.');
    }
  }
}

// The week runs Saturday to Friday, the way it is counted in Egypt.
const weekStart = addDays(day, -((weekdayOf(day) + 1) % 7));
const weekDays = Array.from({ length: 7 }, (_, offset) => addDays(weekStart, offset));

const [appointments, slots, services, counts] = await Promise.all([
  getAppointmentsOn(clinic.id, day),
  getSlots(clinic, day, { forStaff: true }),
  getServices(clinic.id),
  getDayCounts(clinic.id, weekStart, weekDays[6]),
]);

const live = appointments.filter((appointment) => appointment.status !== 'cancelled');
const cancelled = appointments.filter((appointment) => appointment.status === 'cancelled');
const freeSlots = slots.filter((slot) => slot.free);
const count = (status: AppointmentStatus) => appointments.filter((appointment) => appointment.status === status).length;
const revenue = appointments.reduce((sum, appointment) => sum + appointment.paid, 0);

// Waiting patients, first to arrive first.
const queue = live
  .filter((appointment) => appointment.status === 'arrived')
  .sort((a, b) => new Date(a.arrived_at ?? 0).getTime() - new Date(b.arrived_at ?? 0).getTime());

// One timeline row per slot and per booking that sits outside today's slots.
const times = [...new Set([...slots.map((slot) => slot.minute), ...live.map((appointment) => appointment.start_minute)])].sort((a, b) => a - b);
const timeline = times.map((minute) => ({
  minute,
  visits: live.filter((appointment) => appointment.start_minute === minute),
  slot: slots.find((slot) => slot.minute === minute),
}));

const chosenMinute = Number(Astro.url.searchParams.get('minute') ?? -1);

/** The buttons that make sense from each status. */
const nextSteps: Record<AppointmentStatus, AppointmentStatus[]> = {
  booked: ['arrived', 'no_show', 'cancelled'],
  arrived: ['done', 'booked'],
  done: ['arrived'],
  no_show: ['booked'],
  cancelled: ['booked'],
};
const stepLabels: Record<AppointmentStatus, string> = {
  booked: 'رجّعه محجوز',
  arrived: 'وصل',
  done: 'تم الكشف',
  no_show: 'ما جاش',
  cancelled: 'إلغاء',
};

function reminderLink(appointment: Appointment): string {
  const message = `أهلاً ${appointment.patient_name}، بنفكّرك بميعادك في ${clinic.name} يوم ${formatDay(appointment.day)} الساعة ${formatMinute(appointment.start_minute)}. لو مش هتقدر تيجي بلّغنا.`;
  return `https://wa.me/${whatsappNumber(appointment.patient_phone)}?text=${encodeURIComponent(message)}`;
}
---

<Admin title={day === today ? 'مواعيد النهارده' : 'المواعيد'} subtitle={formatDay(day)}>
  <Fragment slot="actions">
    <form class="row" method="get">
      <label class="sr-only" for="date">روح ليوم</label>
      <input id="date" class="auto" name="date" type="date" value={day} />
      <button class="btn btn--sm" type="submit">اعرض</button>
    </form>
    {day !== today && <a class="btn btn--soft btn--sm" href="/admin">النهارده</a>}
    <button class="btn btn--sm" type="button" data-print><Icon name="printer" />اطبع</button>
  </Fragment>

  <nav class="week no-print" aria-label="أيام الأسبوع">
    {
      weekDays.map((weekDay) => {
        const total = counts.get(weekDay) ?? 0;
        return (
          <a href={`/admin?date=${weekDay}`} aria-current={weekDay === day ? 'date' : undefined} data-today={weekDay === today ? '' : undefined}>
            <small>{weekdayNames[weekdayOf(weekDay)]}</small>
            <strong>{Number(weekDay.slice(8))}</strong>
            <span class="week__count" data-empty={total === 0 ? '' : undefined}>{total === 0 ? '·' : total}</span>
          </a>
        );
      })
    }
  </nav>

  {
    problems.length > 0 && (
      <div class="notice notice--error" role="alert">
        <Icon name="ban" />
        <ul>{problems.map((problem) => <li>{problem}</li>)}</ul>
      </div>
    )
  }

  <div class="stats">
    <p class="stat"><span class="stat__icon"><Icon name="calendar" /></span><span><strong>{live.length}</strong><span>حجز</span></span></p>
    <p class="stat"><span class="stat__icon" data-tone="warn"><Icon name="hourglass" /></span><span><strong>{count('arrived')}</strong><span>في الانتظار</span></span></p>
    <p class="stat"><span class="stat__icon" data-tone="ok"><Icon name="check" /></span><span><strong>{count('done')}</strong><span>تم الكشف</span></span></p>
    <p class="stat"><span class="stat__icon" data-tone="bad"><Icon name="ban" /></span><span><strong>{count('no_show')}</strong><span>ما جاش</span></span></p>
    <p class="stat"><span class="stat__icon"><Icon name="wallet" /></span><span><strong>{revenue}</strong><span>إيراد اليوم (ج)</span></span></p>
  </div>

  <div class="board">
    <section class="card" aria-labelledby="timeline-title">
      <div class="card__head">
        <h2 id="timeline-title" class="card__title"><Icon name="clock" />جدول اليوم</h2>
        <span class="muted small">{freeSlots.length} ميعاد فاضي</span>
      </div>

      {
        timeline.length === 0 ? (
          <p class="muted">العيادة إجازة في اليوم ده.</p>
        ) : (
          <ol class="timeline">
            {timeline.map((row) => (
              <li class="tl">
                <span class="tl__time">{formatMinute(row.minute)}</span>
                <div class="stack">
                  {row.visits.length === 0 &&
                    (row.slot?.free ? (
                      <a class="tl__free no-print" href={`${dayPath}&minute=${row.minute}#add-title`}>
                        فاضي <span class="row"><Icon name="plus" />احجز</span>
                      </a>
                    ) : (
                      <span class="tl__free" data-past>{day < today || (day === today && row.minute < now.minute) ? 'فات' : 'مشغول'}</span>
                    ))}

                  {row.visits.map((appointment) => (
                    <article class="visit" data-status={appointment.status}>
                      <div class="row row--spread">
                        <div class="visit__who">
                          <span class="avatar avatar--sm" aria-hidden="true">{appointment.patient_name.charAt(0)}</span>
                          <div>
                            <a href={`/admin/patients/${appointment.patient_phone}`}>{appointment.patient_name}</a>
                            <p class="muted small">
                              {appointment.service_name}{appointment.price > 0 && ` · ${appointment.price} ج`}
                              {appointment.source === 'online' ? ' · أونلاين' : ' · من العيادة'}
                            </p>
                          </div>
                        </div>
                        <span class="badge" data-status={appointment.status}>{statusLabels[appointment.status]}</span>
                      </div>

                      {appointment.note && <p class="small"><Icon name="note" /> {appointment.note}</p>}

                      <div class="row no-print">
                        {nextSteps[appointment.status].map((status) => (
                          <form method="post" action={dayPath}>
                            <input type="hidden" name="_action" value="status" />
                            <input type="hidden" name="id" value={appointment.id} />
                            <input type="hidden" name="status" value={status} />
                            <button class:list={['btn', 'btn--sm', { 'btn--primary': status === 'arrived' || status === 'done', 'btn--danger': status === 'cancelled' }]} type="submit">
                              {stepLabels[status]}
                            </button>
                          </form>
                        ))}
                        {appointment.status === 'booked' && (
                          <a class="btn btn--sm btn--soft" href={reminderLink(appointment)} target="_blank" rel="noopener"><Icon name="chat" />فكّره</a>
                        )}
                        <a class="btn btn--sm btn--ghost ltr" href={`tel:${appointment.patient_phone}`}><Icon name="phone" />{appointment.patient_phone}</a>
                      </div>

                      {appointment.status === 'done' && (
                        <form class="row no-print" method="post" action={dayPath}>
                          <input type="hidden" name="_action" value="paid" />
                          <input type="hidden" name="id" value={appointment.id} />
                          <label class="small muted" for={`paid-${appointment.id}`}>المدفوع (ج)</label>
                          <input id={`paid-${appointment.id}`} class="auto" name="paid" type="number" value={appointment.paid} min="0" required />
                          <button class="btn btn--sm" type="submit">حفظ</button>
                        </form>
                      )}
                    </article>
                  ))}
                </div>
              </li>
            ))}
          </ol>
        )
      }

      {
        cancelled.length > 0 && (
          <details class="no-print">
            <summary>الحجوزات الملغية ({cancelled.length})</summary>
            <ul class="queue">
              {cancelled.map((appointment) => (
                <li>
                  <span class="grow">
                    {formatMinute(appointment.start_minute)} · {appointment.patient_name}
                  </span>
                  <form method="post" action={dayPath}>
                    <input type="hidden" name="_action" value="status" />
                    <input type="hidden" name="id" value={appointment.id} />
                    <input type="hidden" name="status" value="booked" />
                    <button class="btn btn--sm" type="submit">رجّعه</button>
                  </form>
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </section>

    <div class="board__side stack no-print">
      <section class="card" aria-labelledby="queue-title">
        <div class="card__head">
          <h2 id="queue-title" class="card__title"><Icon name="hourglass" />الانتظار دلوقتي</h2>
          <span class="badge" data-status="arrived">{queue.length}</span>
        </div>
        {
          queue.length === 0 ? (
            <p class="muted small">محدش منتظر. لما مريض يوصل دوس "وصل" وهيدخل الطابور بترتيب وصوله.</p>
          ) : (
            <ol class="queue">
              {queue.map((appointment, index) => (
                <li>
                  <span class="queue__place">{index + 1}</span>
                  <span class="grow">
                    <strong>{appointment.patient_name}</strong>
                    <span class="block muted small">ميعاده {formatMinute(appointment.start_minute)}</span>
                  </span>
                  <form method="post" action={dayPath}>
                    <input type="hidden" name="_action" value="status" />
                    <input type="hidden" name="id" value={appointment.id} />
                    <input type="hidden" name="status" value="done" />
                    <button class="btn btn--sm btn--primary" type="submit">تم</button>
                  </form>
                </li>
              ))}
            </ol>
          )
        }
      </section>

      <section class="card" aria-labelledby="add-title">
        <h2 id="add-title" class="card__title"><Icon name="plus" />حجز جديد</h2>
        {
          freeSlots.length === 0 || services.length === 0 ? (
            <p class="muted small">{services.length === 0 ? 'ضيف نوع زيارة من الإعدادات الأول.' : 'مفيش مواعيد فاضية في اليوم ده.'}</p>
          ) : (
            <form class="stack" method="post" action={dayPath}>
              <input type="hidden" name="_action" value="add" />
              <div class="grid-2">
                <div class="field">
                  <label for="add-minute">الساعة</label>
                  <select id="add-minute" name="minute" required>
                    {freeSlots.map((slot) => <option value={slot.minute} selected={slot.minute === chosenMinute}>{formatMinute(slot.minute)}</option>)}
                  </select>
                </div>
                <div class="field">
                  <label for="add-service">نوع الزيارة</label>
                  <select id="add-service" name="service" required>
                    {services.map((service) => <option value={service.id}>{service.name}</option>)}
                  </select>
                </div>
              </div>
              <div class="field">
                <label for="add-name">اسم المريض</label>
                <input id="add-name" name="name" type="text" value={typed.name} required minlength="3" maxlength="80" />
              </div>
              <div class="field">
                <label for="add-phone">رقم الموبايل</label>
                <input id="add-phone" class="ltr" name="phone" type="tel" value={typed.phone} inputmode="tel" placeholder="01xxxxxxxxx" required />
              </div>
              <button class="btn btn--primary btn--block" type="submit">احجز</button>
            </form>
          )
        }
      </section>
    </div>
  </div>
</Admin>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
