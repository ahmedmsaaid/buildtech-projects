---
/** Appearance of the clinic's booking page, the patient's ticket and this dashboard. */
import AppearanceEditor from '../../components/AppearanceEditor.astro';
import Icon from '../../components/Icon.astro';
import Admin from '../../layouts/Admin.astro';
import { saveAppearance } from '../../lib/theme';

const { clinic } = Astro.locals;
let problem: string | null = null;

if (Astro.request.method === 'POST') {
  problem = await saveAppearance(clinic.id, await Astro.request.formData());
  if (!problem) return Astro.redirect('/admin/appearance?saved');
}
---

<Admin title="المظهر" subtitle="شكل صفحة الحجز واللوحة: الألوان والخط والأشكال">
  <a slot="actions" class="btn btn--sm btn--soft" href={`/${clinic.slug}`} target="_blank" rel="noopener"><Icon name="external" />افتح صفحة الحجز</a>

  {Astro.url.searchParams.has('saved') && <p class="notice" role="status"><Icon name="check" />الشكل اتحفظ واتطبّق على صفحة الحجز واللوحة.</p>}
  {problem && <p class="notice notice--error" role="alert"><Icon name="ban" />{problem}</p>}

  <AppearanceEditor account={clinic} publicPage="صفحة الحجز" />
</Admin>
