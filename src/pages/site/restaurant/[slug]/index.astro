---
/**
 * A restaurant's public menu, and ordering from it. A guest who scanned a
 * table's QR code arrives with ?t=<table> and orders to that table; anyone
 * else orders to collect. The page is one form, so it works without
 * JavaScript; the script only adds the plus and minus buttons and the running total.
 */
import Icon from '../../../../components/Icon.astro';
import Base from '../../../../layouts/Base.astro';
import { placeOrder } from '../../../../lib/orders';
import { bookingLimiter } from '../../../../lib/rate-limit';
import { getMenu, getRestaurantBySlug } from '../../../../lib/restaurants';
import { themeOf } from '../../../../lib/theme';
import { egyptianMobile, text } from '../../../../lib/validate';

const restaurant = await getRestaurantBySlug(Astro.params.slug ?? '');
if (!restaurant) return new Response(null, { status: 404 });

const menu = await getMenu(restaurant.id);
const isOpen = restaurant.status === 'active' && restaurant.accepts_orders;

// The table comes from the QR code. A number outside the restaurant's tables is ignored.
const tableParam = Number(Astro.url.searchParams.get('t'));
const table = Number.isInteger(tableParam) && tableParam >= 1 && tableParam <= restaurant.tables_count ? tableParam : null;
const canOrder = isOpen && (table !== null || restaurant.allows_pickup);

const problems: string[] = [];
let typed = { name: '', phone: '', note: '' };
const quantities = new Map<string, number>();

if (Astro.request.method === 'POST' && isOpen) {
  const form = await Astro.request.formData();
  typed = { name: text(form, 'name', 80), phone: text(form, 'phone', 20), note: text(form, 'note', 300) };

  for (const [field, value] of form) {
    if (field.startsWith('q_') && typeof value === 'string' && /^\d{1,3}$/.test(value)) quantities.set(field.slice(2), Number(value));
  }

  // Honeypot: people never see this field, so anything in it is a bot.
  const isBot = text(form, 'website') !== '';
  const mobile = typed.phone ? egyptianMobile(typed.phone) : '';
  if (mobile === null) problems.push('رقم الموبايل لازم يكون 11 رقم ويبدأ بـ 01.');
  if (!isBot && bookingLimiter.isLimited(Astro.clientAddress)) problems.push('محاولات كتير في وقت قصير. جرّب تاني بعد شوية.');

  if (problems.length === 0 && mobile !== null && !isBot) {
    const result = await placeOrder(restaurant, { tableNumber: table, customerName: typed.name, customerPhone: mobile, note: typed.note, quantities });
    if (result.ok) return Astro.redirect(`/${restaurant.slug}/order/${result.id}`);

    const messages: Record<typeof result.reason, string> = {
      closed: 'المطعم مش بيستقبل طلبات دلوقتي.',
      empty: 'اختار صنف واحد على الأقل.',
      unavailable: 'فيه صنف خلص من شوية. راجع طلبك.',
      bad_table: 'رقم الترابيزة مش صحيح. امسح الكود اللي على الترابيزة تاني.',
      pickup_off: 'الطلب متاح من الترابيزة بس. امسح الكود اللي على ترابيزتك.',
      contact_needed: 'اكتب اسمك ورقم موبايلك عشان نبلّغك لما الطلب يجهز.',
      too_big: 'الطلب كبير قوي. قسّمه على طلبين أو كلّم المطعم.',
    };
    problems.push(messages[result.reason]);
  }
}

const initial = restaurant.name.trim().charAt(0);
---

<Base title={`منيو ${restaurant.name}`} theme={themeOf(restaurant)}>
  <main class="shell shell--menu">
    <header class="hero">
      <div class="hero__id">
        <span class="avatar" aria-hidden="true">{initial}</span>
        <div>
          <h1>{restaurant.name}</h1>
          {restaurant.cuisine && <p>{restaurant.cuisine}</p>}
        </div>
      </div>

      <div class="hero__meta">
        {table !== null && <span class="chip"><Icon name="building" />ترابيزة {table}</span>}
        {restaurant.hours_note && <span class="chip"><Icon name="clock" />{restaurant.hours_note}</span>}
        {restaurant.address && (
          restaurant.map_url ? (
            <a class="chip" href={restaurant.map_url} target="_blank" rel="noopener"><Icon name="pin" />{restaurant.address}</a>
          ) : (
            <span class="chip"><Icon name="pin" />{restaurant.address}</span>
          )
        )}
        {restaurant.phone && <a class="chip ltr" href={`tel:${restaurant.phone}`}><Icon name="phone" />{restaurant.phone}</a>}
      </div>
    </header>

    {restaurant.about && <p class="card">{restaurant.about}</p>}

    {
      problems.length > 0 && (
        <div class="notice notice--error" role="alert">
          <Icon name="ban" />
          <ul>{problems.map((problem) => <li>{problem}</li>)}</ul>
        </div>
      )
    }
    {!isOpen && <p class="notice notice--error" role="status"><Icon name="ban" />المطعم مش بيستقبل طلبات أونلاين دلوقتي. تقدر تتفرج على المنيو.</p>}
    {isOpen && !canOrder && <p class="notice" role="status"><Icon name="building" />عشان تطلب، امسح الكود اللي على ترابيزتك.</p>}

    {
      menu.length === 0 ? (
        <p class="card muted">المنيو لسه بيتجهّز.</p>
      ) : (
        <>
          <nav class="menu-nav" aria-label="أقسام المنيو">
            {menu.map((category) => <a class="chip" href={`#c-${category.id}`}>{category.name}</a>)}
          </nav>

          <form class="stack" method="post" data-order-form>
            {menu.map((category) => (
              <section class="card" id={`c-${category.id}`} aria-labelledby={`t-${category.id}`}>
                <h2 id={`t-${category.id}`} class="card__title"><Icon name="note" />{category.name}</h2>
                <ul class="dishes">
                  {category.items.map((item) => (
                    <li class="dish" data-sold-out={item.is_available ? undefined : ''}>
                      <div class="dish__text">
                        <h3>{item.name}</h3>
                        {item.description && <p class="muted small">{item.description}</p>}
                        <p class="dish__price">{item.price} ج</p>
                      </div>
                      {!item.is_available ? (
                        <span class="badge" data-status="cancelled">خلص</span>
                      ) : (
                        canOrder && (
                          <div class="stepper" data-stepper>
                            <button class="btn btn--sm" type="button" data-step="-1" aria-label={`قلّل ${item.name}`} hidden>−</button>
                            <label class="sr-only" for={`q-${item.id}`}>عدد {item.name}</label>
                            <input id={`q-${item.id}`} name={`q_${item.id}`} type="number" min="0" max="20" value={quantities.get(item.id) ?? 0} data-price={item.price} inputmode="numeric" />
                            <button class="btn btn--sm btn--primary" type="button" data-step="1" aria-label={`زوّد ${item.name}`} hidden>+</button>
                          </div>
                        )
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            ))}

            {
              canOrder && (
                <section class="card" aria-labelledby="you-title">
                  <h2 id="you-title" class="card__title"><Icon name="users" />{table !== null ? `طلب ترابيزة ${table}` : 'طلب للاستلام'}</h2>
                  <div class="grid-2">
                    <div class="field">
                      <label for="name">الاسم{table !== null && ' (اختياري)'}</label>
                      <input id="name" name="name" type="text" value={typed.name} autocomplete="name" maxlength="80" required={table === null} />
                    </div>
                    <div class="field">
                      <label for="phone">رقم الموبايل{table !== null && ' (اختياري)'}</label>
                      <input id="phone" class="ltr" name="phone" type="tel" value={typed.phone} autocomplete="tel" inputmode="tel" placeholder="01xxxxxxxxx" required={table === null} />
                    </div>
                  </div>
                  <div class="field">
                    <label for="note">ملاحظة للمطبخ (اختياري)</label>
                    <textarea id="note" name="note" rows="2" maxlength="300" placeholder="من غير بصل، حار زيادة...">{typed.note}</textarea>
                  </div>

                  <div class="trap" aria-hidden="true">
                    <label for="website">سيب الخانة دي فاضية</label>
                    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
                  </div>

                  <p class="hint">الطلب بيجهز في حوالي {restaurant.prep_minutes} دقيقة. الدفع في المطعم.</p>
                </section>
              )
            }

            {
              canOrder && (
                <div class="cartbar">
                  <span class="cartbar__sum">
                    <strong data-cart-total>0</strong> ج
                    <small class="muted"><span data-cart-count>0</span> صنف</small>
                  </span>
                  <button class="btn btn--primary" type="submit"><Icon name="check" />ابعت الطلب</button>
                </div>
              )
            }
          </form>
        </>
      )
    }

    <p class="foot">المنيو والطلبات من BuildTech</p>
  </main>
</Base>

<script>
  // Plus and minus buttons, and a running total. The quantities themselves
  // are ordinary number inputs, so the order still sends without this script.
  const form = document.querySelector<HTMLFormElement>('[data-order-form]');
  const total = document.querySelector('[data-cart-total]');
  const count = document.querySelector('[data-cart-count]');
  const inputs = [...(form?.querySelectorAll<HTMLInputElement>('input[data-price]') ?? [])];

  function refresh() {
    let sum = 0;
    let items = 0;
    for (const input of inputs) {
      const quantity = Math.max(0, Math.min(20, Number(input.value) || 0));
      sum += quantity * Number(input.dataset.price);
      items += quantity;
      // The minus button only appears once there is something to take away.
      const minus = input.closest('[data-stepper]')?.querySelector<HTMLButtonElement>('[data-step="-1"]');
      if (minus) minus.disabled = quantity === 0;
    }
    if (total) total.textContent = String(sum);
    if (count) count.textContent = String(items);
  }

  form?.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => {
      const input = button.closest('[data-stepper]')?.querySelector<HTMLInputElement>('input');
      if (!input) return;
      input.value = String(Math.max(0, Math.min(20, (Number(input.value) || 0) + Number(button.dataset.step))));
      refresh();
    });
  });

  form?.addEventListener('input', refresh);
  refresh();
</script>
