# Postgres connection string (Supabase: Project Settings > Database >
# Connection string > Transaction pooler). Leave empty in development: the
# app then keeps a local database in .data/ and fills it with a demo clinic.
DATABASE_URL=

# The live database link for the setup commands goes in .env.deploy instead
# (see README, "Going live"), so local development never touches live data.

# Shared with the owner dashboard (a separate project) so it can ask this
# project to do what only a product knows how to do. Any long random text,
# at least 32 characters, the same in both projects. Without it the routes
# under /internal answer "not found".
#
# It is also what the links to customers' own databases are encrypted with.
# Changing it makes those stored links unreadable, so do not change it once
# customers have databases of their own.
INTERNAL_API_SECRET=
